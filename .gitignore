# ── Terraform ─────────────────────────────────────────────
# State is sensitive and lives in a remote backend, never in Git.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Commit the provider lock file for reproducible plans:
!.terraform.lock.hcl
# ...but NOT inside terraform/modules/ — a lock file is a ROOT-module artifact.
# One appears there only if someone runs `terraform init` in the module dir (e.g.
# to `validate` it), and it then goes stale because nothing ever re-inits it.
terraform/modules/*/.terraform.lock.hcl

# Compiled desired-state is a BUILD ARTIFACT, not source. Intents (intent/**) are
# the source of truth; CI compiles them fresh for plan/apply, so requesters never
# run the compiler and never commit these. (Do NOT track them — that forced a
# manual `fwgitops compile` step on requesters, breaking the no-tooling path.)
# Glob, not one line per kind. Listing them individually meant every new intent
# kind needed a matching gitignore line, and forgetting it commits a build
# artifact that can then go stale against the intent it claims to represent.
# ZoneRequest already shipped once without its Terraform wiring for exactly this
# shape of omission (ADR-0004) — one pattern that cannot be forgotten is better
# than a checklist item that can.
terraform/*/*.auto.tfvars.json
# Secret-bearing tfvars (conventional) stay out:
terraform.tfvars
*.secret.tfvars
secrets.auto.tfvars

# ── Secrets / credentials ─────────────────────────────────
.env
.env.*
*.pem
*.key
*_service_account*.json
sa-key*.json
gcp-*.json
aws-credentials*
credentials.json
# Rendered bootstrap packages carry device/vm auth-keys — never commit rendered
# artifacts; templates under provisioning/bootstrap/ ARE tracked.
provisioning/bootstrap/*.rendered
*.rendered.txt
*.rendered.xml

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# NOTE: evidence/ is intentionally TRACKED — evidence bundles are Git-resident
# (Git = single source of truth for audit). Do not ignore evidence/.

# ── OS / editor ───────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Per-folder filled backend config (names the AWS account)
backend.hcl
tfplan
tfplan-*
.gstack/
